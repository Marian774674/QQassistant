# 主动发送桥（默认 127.0.0.1:5301）。变量可直接 export，也可写进进程环境。
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5301

# LangBot 官方 HTTP API
LANGBOT_BASE=http://localhost:5300
LANGBOT_BOT_UUID=
LANGBOT_API_KEY=

# NapCat OneBot 11 HTTP（文件发送回落通道）
NAPCAT_BASE=http://localhost:3000
NAPCAT_TOKEN=

# Spring Boot（写 OUT 日志）
SPRING_BASE=http://localhost:8080

# 拟人延迟：仅私聊生效；delayMs 显式传入时以请求为准
DELAY_BASE_MS=1500
DELAY_PER_CHAR_MS=150
DELAY_JITTER_MS=1000
DELAY_MAX_MS=15000

# LangBot send_message 是否接受 File 组件；实测不支持时保持 false（直连 NapCat）
FILE_VIA_LANGBOT=false

# bizRef 幂等（秒）
IDEMPOTENCY_TTL=86400
# 不填则默认落在 send_bridge/data/sent.json 的绝对路径（与启动目录无关）
# STATE_FILE=/absolute/path/sent.json
