# 复制为 .env 后逐项填写：cp .env.example .env

# ── 镜像 ────────────────────────────────────────────────────────────────
# 国内拉不动 Docker Hub 时可换镜像源：
# LANGBOT_IMAGE=docker.langbot.app/langbot-public/rockchin/langbot:latest
# 生产建议固定版本，例如 rockchin/langbot:v4.10.7
LANGBOT_IMAGE=rockchin/langbot:latest
# send_bridge 镜像的基础镜像；Docker Hub 拉不动时换国内源
PYTHON_IMAGE=python:3.12-slim

# langbot 与插件运行时共用的控制令牌：都留空，或都填同一个 ≥32 位随机串
PLUGIN_RUNTIME_CONTROL_TOKEN=

# ── 端口绑定（默认只绑本机，配 SSH 隧道访问；需要局域网直连再改成 0.0.0.0）──
WEBUI_BIND=127.0.0.1
NAPCAT_WEBUI_BIND=127.0.0.1
# NapCat WebUI 映射到宿主机的端口（容器内固定 6099；6099 被占用就用 6098）
NAPCAT_WEBUI_PORT=6098
BRIDGE_BIND=0.0.0.0

# ── NapCat ─────────────────────────────────────────────────────────────
# 宿主机上执行 id -u / id -g 的结果（root 用 0/0）
NAPCAT_UID=1000
NAPCAT_GID=1000
# NapCat WebUI 登录口令，务必换成强口令（compose 用 :? 强制非空）
NAPCAT_WEBUI_TOKEN=
# OneBot HTTP 服务器口令：在 NapCat WebUI 里启用 HTTP 3000 时填同一个值
NAPCAT_HTTP_TOKEN=

# ── LangBot ────────────────────────────────────────────────────────────
# LangBot WebUI → 机器人 → 你的 QQ 机器人 → 详情里的 UUID
LANGBOT_BOT_UUID=
# LangBot WebUI → 设置 → API 密钥（api.global_api_key），发送桥要用
LANGBOT_API_KEY=

# ── Redis（登录会话 / 验证码 / 接口限流）────────────────────────────────
# 务必换成强口令；Spring Boot 侧用 REDIS_PASSWORD 同名环境变量注入
REDIS_PASSWORD=
# 默认允许局域网访问；只走 SSH 隧道时改成 127.0.0.1
REDIS_BIND=0.0.0.0
REDIS_IMAGE=redis:7-alpine

# ── Spring Boot ────────────────────────────────────────────────────────
# Spring Boot 所在机器（Windows 宿主机）对虚拟机/容器可达的地址，带端口。
# 下面只是示例地址，按你的网络改；写 127.0.0.1 在容器里指的是容器自己。
SPRING_BASE=http://192.168.100.1:8080

# ── 登录 ───────────────────────────────────────────────────────────────
# 首次登录用的初始密码；不填则启动日志打印随机临时密码，登录后请修改
AUTH_INITIAL_PASSWORD=
# 主人 QQ 号：网页「QQ 授权登录」的验证码只发到这个号。
# 也可以留空，先用密码登录后在「设置 → 我的 QQ 号」里绑定（绑定后以数据库为准）
AUTH_OWNER_QQ=
